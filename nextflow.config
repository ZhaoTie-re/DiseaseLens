/* ============================================================================
 * DiseaseLens — parameters and execution profile
 *
 * A run builds one snapshot for each disease it names:
 *   nextflow run main.nf --diseases cteph,hpah --FetchDate 2026-10-20
 *   nextflow run main.nf -params-file projects/pulmonary_hypertension.yaml
 * Your own settings (python, the language models) go in a config file you pass
 * with -c (copy conf/local.config.example to conf/local.config, which git
 * ignores), or in a params file. Keys of an API are never written anywhere:
 * the model configuration names the environment variable that holds them.
 *
 * Every process is local (executor 'local' in main.nf): compute nodes may have
 * no internet. Results:
 *   results/<disease>/snapshots/<FetchDate>/   sources, evidence, tables, graph,
 *                                             products, _run_info
 *   results/<disease>/latest.json              the disease's newest snapshot
 *   results/index.json, results/README.md      every disease of the results
 * ==========================================================================*/

params {
    // ---- What to build
    diseases            = ''        // keys of diseases/<key>/, comma-separated; or a list in a params file
    FetchDate           = null      // YYYY-MM-DD: the snapshot date of every disease that names none
    Rebuild             = false     // true, or keys: re-derive the snapshot of the fetch date from its saved sources

    // ---- Where things are
    base_dir            = "${projectDir}"
    script_dir          = "${projectDir}/scripts"
    diseases_dir        = "${projectDir}/diseases"
    config_dir          = "${projectDir}/config"
    plot_style          = "${projectDir}/scripts/plot_style.py"
    results_root        = "${projectDir}/results"
    llm_cache_dir       = "${projectDir}/cache/llm"   // model answers, kept across snapshots
    llm_workdir         = '/tmp/diseaselens_llm'      // the command-line model runs here, away from the project

    // ---- Tools
    python              = 'python3'  // with the packages of requirements.txt

    // ---- Language models: two independent readers and an adjudicator (README, "Configure the language models").
    //      provider: claude-cli | anthropic | openai; three different models, each named (a backend's default model
    //      changes with its version, and the answers are cached per model);
    //      api_key_env: the NAME of the environment variable that holds the key (anthropic, openai);
    //      base_url: the OpenAI-compatible endpoint (openai)
    llm = [
        readers    : [
            [name: 'A', provider: 'claude-cli', model: 'claude-opus-5'],
            [name: 'B', provider: 'claude-cli', model: 'claude-sonnet-5-5'],
        ],
        adjudicator: [provider: 'claude-cli', model: 'claude-opus-5-5'],
        bin        : 'claude',   // the claude CLI (claude-cli)
        parallel   : 3,          // calls at a time, per reader
        timeout    : 600,        // seconds per call
        max_tokens : 16000,      // anthropic
    ]
    LlmOffline          = false   // true: cached model answers only, never call a model
    LlmBatch            = 5       // abstracts per reading call
    LlmLimit            = 0       // smoke run: the first N PubMed records only (0 = all)
    MaxThemes           = 0       // smoke run: the N largest mechanism themes only, no methods / findings summaries
    Prescreen           = true    // drop reviews / records without a genetic-study term before a model reads them

    // ---- Open Targets
    ot_api              = 'https://api.platform.opentargets.org/api/v4/graphql'
    ClppMin             = 0.01    // colocalization with a region of the disease: eCAVIAR CLPP ...
    H4Min               = 0.8     // ... or coloc H4
    MendelianMin        = 0.5     // smallest curated / Mendelian source score kept
    L2gMin              = 0.5     // top locus-to-gene score for a gene-condition link
    EasMin              = 0.5     // East Asian share of a GWAS sample to flag it
    MaxGwasStudies      = 100     // a related condition with more GWAS studies keeps its shared signals only
    MaxOntologyChildren = 30      // a parent with more children is too broad a class to give neighbors
    GenomeWideP         = 5e-8    // lead P of a GWAS region of the disease (from Open Targets)
    RegionMinMaf        = 0.01    // a lead of such a region rarer than this needs P < RareVariantP
    RegionMinMac        = 25      // ... and every lead: expected copies of its minor allele in the smaller group (cases)
    RareVariantP        = 5e-9    // P of a rare lead (MAF < RegionMinMaf) of such a region
    RegionWindowKb      = 500     // credible sets whose lead variants lie this close are one region
    PageSize            = 100
    EvidencePage        = 500

    // ---- Summaries
    SentencesPerPaper   = 3
    ThemeTargets        = 12      // targets whose sentences feed a theme summary
    MinThemeTargets     = 3
}

process {
    // 'finish' rather than 'terminate': a failing task lets the running ones
    // complete, and a -resume after the fix starts from their cached results.
    errorStrategy = 'finish'
}

// Run records, per run (git-ignored: they hold paths of the machine that ran it). trace.txt keeps no paths.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.results_root}/_runs/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.results_root}/_runs/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.results_root}/_runs/timeline.html"
}

manifest {
    name        = 'DiseaseLens'
    homePage    = 'https://github.com/ZhaoTie-re/DiseaseLens'
    mainScript  = 'main.nf'
    description = 'Dated, traceable knowledge graphs of the genetics of any disease in Open Targets and of the conditions related to it: GWAS regions, curated genes and the genetic studies of the literature (read by two independent language-model readers and checked against their source text), related conditions with their evidence, shared regions and genes; tables, graph, knowledge base, workbook and viewer for each disease.'
}
