/* ============================================================================
 * cteph_knowledge_graph — execution profile
 *
 * Every process is local (executor 'local' in the .nf): compute nodes have no
 * internet, and the snapshot is small (2026-10-16: Open Targets fetches ~5 min,
 * PubMed ~1 min, ~30 MB). The language-model steps call the `claude` CLI from
 * the launch host; their answers are cached in cache/llm across snapshots. No
 * SLURM resources are needed; should a step ever move to SLURM, resources go
 * through --rsc only.
 *
 * One run = one snapshot, named by --FetchDate (YYYY-MM-DD):
 *   results/snapshots/<FetchDate>/   raw responses, PubMed records, conditions,
 *                                    literature extraction, tables and graph,
 *                                    summaries, changes, knowledge, workbook,
 *                                    _run_info
 *   results/latest.json              the newest complete snapshot
 * ==========================================================================*/

// Here rather than in the .nf so that the run records follow the snapshot.
params.FetchDate      = null
params.results_root   = "${projectDir}/results"
params.snapshots_root = "${params.results_root}/snapshots"
params.out_dir        = "${params.snapshots_root}/${params.FetchDate ?: '_no_date'}"
params.run_info_dir   = "${params.out_dir}/_run_info"

process {
    // 'finish' rather than 'terminate': a failing task lets the running ones
    // complete, and a -resume after the fix starts from their cached results.
    errorStrategy = 'finish'
}

// Provenance: a trace is the only way to tell a cached task from a completed one.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}

manifest {
    name        = 'cteph_knowledge_graph'
    mainScript  = 'cteph_knowledge_graph.nf'
    description = 'Dated snapshots of a CTEPH knowledge graph: the conditions related to CTEPH with their evidence (PubMed-verified clinical relations, ontology, GWAS colocalisation), the genetics of CTEPH and of those conditions (GWAS, curated Mendelian genes, the genetic studies of CTEPH with their methods), mechanisms, East Asian evidence; tables, graph, knowledge base, workbook and the changes since the previous snapshot.'
}
